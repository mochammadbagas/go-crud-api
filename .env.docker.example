PORT=8080
DB_HOST=mysql
DB_PORT=3306
DB_USER=go_crud_api
DB_PASSWORD=ganti_dengan_password_yang_kuat
DB_NAME=go_crud_api
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=60
DB_CONN_MAX_IDLE_TIME_MINUTES=10

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@mmdbconnect.com
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat

COOKIE_SECURE=false
COOKIE_DOMAIN=
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Authentication
JWT_SECRET=super-secret-starter-kit-jwt-key-change-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Mailer Configuration (Pluggable Architecture)
# Driver options: "log" (default lokal dev, print outbox ke terminal) atau "resend" (production)
MAILER_DRIVER=log
FRONTEND_URL=http://localhost:3000

# Diperlukan hanya jika MAILER_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=Go Starter Kit <no-reply@localhost>

# Pluggable Storage Configuration (Local, Cloudflare R2, AWS S3)
# Driver options: "local" (default dev lokal, simpan di UPLOAD_DIR) atau "r2" / "s3" (production)
STORAGE_DRIVER=local

# Konfigurasi di bawah hanya diperlukan jika STORAGE_DRIVER=r2 atau s3
S3_BUCKET=
S3_REGION=auto
# Untuk Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL Publik (Custom domain e.g. https://cdn.domain.com atau domain R2 pub e.g. https://pub-xxx.r2.dev)
S3_PUBLIC_URL=

