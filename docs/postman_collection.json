		{
			"name": "1. Autentikasi Administrator",
			"description": "Endpoint login, profil, dan logout admin menggunakan session cookie / bearer token.",
			"item": [
				{
					"name": "1.1 Login Administrator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 200 && jsonData.session_id) {",
									"    pm.collectionVariables.set(\"sessionToken\", jsonData.session_id);",
									"    console.log(\"Session ID otomatis tersimpan: \" + jsonData.session_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@mmdbconnect.com\",\n  \"password\": \"adminpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"login"
							]
						},
						"description": "Melakukan login admin. Menyimpan HTTP-only cookie 'session_id' secara otomatis di Postman dan mengisi variabel {{sessionToken}}."
					},
					"response": []
				},
