		{
			"name": "3. Admin Management",
			"description": "Endpoint pengelolaan konten (Posts, Categories, dan Upload Cover) yang diproteksi Role Admin.",
			"item": [
				{
					"name": "3.1 Daftar Postingan (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/posts?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "posts"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						},
						"description": "Mengambil seluruh daftar postingan (draft maupun published)."
					},
					"response": []
				},
				{
					"name": "3.2 Buat Postingan Baru",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 201 && jsonData.id) {",
									"    pm.collectionVariables.set(\"samplePostId\", jsonData.id);",
									"    console.log(\"Post ID (ULID) otomatis tersimpan: \" + jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
