	"item": [
		{
			"name": "0. System Health & Probes",
			"description": "Endpoint health check sistem, liveness probe, dan readiness probe (terkoneksi langsung dengan status MySQL database).",
			"item": [
				{
					"name": "0.1 Full System Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Pemeriksaan kesehatan sistem menyeluruh termasuk verifikasi koneksi dan query ping ke MySQL database."
					},
					"response": []
				},
				{
					"name": "0.2 Liveness Probe",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/live",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"live"
							]
						},
						"description": "Liveness probe instan untuk orkestrator kontainer (Kubernetes / Docker) untuk memverifikasi proses server berjalan."
					},
					"response": []
				},
				{
					"name": "0.3 Readiness Probe",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/ready",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"ready"
							]
						},
						"description": "Readiness probe untuk ingress load balancer untuk memastikan server dan database siap menerima lalu lintas HTTP."
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Authentication",
			"description": "Endpoint Autentikasi Pengguna & Admin (Register, Login, Refresh Token RTR, Logout, Change Password).",
			"item": [
				{
					"name": "1.1 Register Akun Baru",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"John Doe\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Registrasi pengguna baru dengan validasi format email, kekuatan password, dan pembuatan profil default."
					},
					"response": []
				},
				{
					"name": "1.2 Login (Mendapatkan Token Hybrid)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 200 && jsonData.access_token) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.access_token);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refresh_token);",
									"    console.log(\"Access Token & Refresh Token otomatis tersimpan di variable!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@mmdbconnect.com\",\n  \"password\": \"adminpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login pengguna/admin. Mengembalikan JWT Access Token dan Refresh Token, serta otomatis menyetel HTTP-only cookie."
					},
					"response": []
				},
				{
					"name": "1.3 Refresh Token (Rotation & RTR)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 200 && jsonData.access_token) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.access_token);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refresh_token);",
									"    console.log(\"Token berhasil dirotasi dan disimpan ulang!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Memperoleh Access Token baru menggunakan Refresh Token. Menerapkan rotasi token & deteksi reuse pembajakan sesi."
					},
					"response": []
				},
				{
					"name": "1.4 Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.set(\"accessToken\", \"\");",
									"    pm.collectionVariables.set(\"refreshToken\", \"\");",
									"    console.log(\"Access Token & Refresh Token berhasil dibersihkan dari variable Postman!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Mencabut refresh token dan menghapus cookie autentikasi."
					},
					"response": []
				},
				{
					"name": "1.5 Ganti Password",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"old_password\": \"adminpassword123\",\n  \"new_password\": \"newpassword12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "change-password"]
						},
						"description": "Mengganti password akun dan mencabut seluruh sesi refresh token aktif pengguna."
					},
					"response": []
				},
				{
					"name": "1.6 Lupa Password (Forgot Password)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@mmdbconnect.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "forgot-password"]
						},
						"description": "Mengirim tautan reset password. Proteksi anti user-enumeration (selalu mengembalikan 200 OK)."
					},
					"response": []
				},
				{
					"name": "1.7 Reset Password (dengan Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{sampleToken}}\",\n  \"new_password\": \"newpassword12345\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "reset-password"]
						},
						"description": "Mengatur ulang password menggunakan token reset dari email (disimpan di variabel {{sampleToken}}). Mencabut seluruh refresh token aktif."
					},
					"response": []
				},
				{
					"name": "1.8 Verifikasi Email (Token via Query)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email?token={{sampleToken}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "verify-email"],
							"query": [
								{
									"key": "token",
									"value": "{{sampleToken}}",
									"description": "Token verifikasi yang didapat dari email / terminal LogMailer"
								}
							]
						},
						"description": "Verifikasi alamat email pengguna via tautan browser / GET request."
					},
					"response": []
				},
				{
					"name": "1.9 Verifikasi Email (Token via Body)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{sampleToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "verify-email"]
						},
						"description": "Verifikasi alamat email pengguna via JSON payload POST (Mobile / API Client)."
					},
					"response": []
				},
				{
					"name": "1.10 Kirim Ulang Email Verifikasi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@mmdbconnect.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/resend-verification",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "resend-verification"]
						},
						"description": "Mengirim ulang tautan verifikasi email jika token kedaluwarsa atau belum diterima. Dilengkapi anti-enumerasi."
					},
					"response": []
				}
			]
		},
