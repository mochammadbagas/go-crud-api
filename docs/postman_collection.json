{
	"info": {
		"_postman_id": "a9d7e32a-5b12-4f38-9cb1-8b27341d1a89",
		"name": "Go CRUD API - Product & Auth",
		"description": "Koleksi resmi pengujian API Go CRUD dengan autentikasi JWT dan database relasi MySQL.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Register User Baru",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"register"
							]
						},
						"description": "Registrasi akun pengguna baru (Publik)"
					},
					"response": []
				},
				{
					"name": "1.2 Login & Dapatkan Token JWT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"    console.log(\"Token JWT otomatis tersimpan di variable {{token}}\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Login untuk mendapatkan token JWT (Token otomatis tersimpan di variabel koleksi Postman)"
					},
					"response": []
				},
				{
					"name": "1.3 Cek Profil Saya (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"me"
							]
						},
						"description": "Mengambil data profil pengguna yang sedang login (Terproteksi JWT)"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Products (Public Read)",
			"item": [
				{
					"name": "2.1 Ambil Semua Produk",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						},
						"description": "Menampilkan daftar seluruh produk dengan kategori yang sudah di-preload (Publik)"
					},
					"response": []
				},
				{
					"name": "2.2 Ambil Detail Produk by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						},
						"description": "Mengambil detail satu produk berdasarkan ID (Publik)"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Products (Protected Write)",
			"item": [
				{
					"name": "3.1 Tambah Produk Baru",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Headphone Bluetooth ANC\",\n  \"price\": 1250000,\n  \"stock\": 10,\n  \"category_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						},
						"description": "Menambahkan produk baru ke database (Wajib menyertakan Token JWT)"
					},
					"response": []
				},
				{
					"name": "3.2 Update Produk by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Keyboard Mekanikal Wireless Pro\",\n  \"price\": 650000,\n  \"stock\": 25,\n  \"category_id\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						},
						"description": "Mengubah data produk yang ada secara penuh (Wajib menyertakan Token JWT)"
					},
					"response": []
				},
				{
					"name": "3.3 Hapus Produk (Soft Delete)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"1"
							]
						},
						"description": "Menghapus produk menggunakan soft delete / 204 No Content (Wajib menyertakan Token JWT)"
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	]
}
